{
  "name": "playwright-api-wrapper",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight HTTP API that runs one Playwright scenario per request.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "bun check",
    "fixture": "bun fixture/server.ts",
    "test": "bun test test/unit test/integration",
    "coverage": "bun test test/unit test/integration --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:e2e": "bun test test/e2e",
    "newman": "bun scripts/newman.mjs",
    "postman": "bun scripts/postman-cli.mjs",
    "compose:test": "docker compose --profile test up --build",
    "verify": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.8",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
